@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(CURL)
find_dependency(Threads)
find_dependency(nlohmann_json 3.7)

include("${CMAKE_CURRENT_LIST_DIR}/pipecatTargets.cmake")

# Transports are components, e.g. find_package(pipecat COMPONENTS daily) for
# pipecat::daily. Each loads its own dependencies.
foreach(_pipecat_component IN LISTS pipecat_FIND_COMPONENTS)
  set(_pipecat_file "${CMAKE_CURRENT_LIST_DIR}/pipecat-${_pipecat_component}.cmake")
  if(EXISTS "${_pipecat_file}")
    include("${_pipecat_file}")
  else()
    set(pipecat_${_pipecat_component}_FOUND FALSE)
    set(pipecat_NOT_FOUND_MESSAGE
      "pipecat was built without the ${_pipecat_component} transport"
    )
  endif()
endforeach()

check_required_components(pipecat)
