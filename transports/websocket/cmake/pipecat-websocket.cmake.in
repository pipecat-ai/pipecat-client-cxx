# The WebSocket transport, pipecat::websocket, loaded by
# find_package(pipecat COMPONENTS websocket).

# A static libdatachannel's package doesn't look for OpenSSL itself.
if("@PIPECAT_WEBSOCKET_LIBDATACHANNEL_TYPE@" STREQUAL "STATIC_LIBRARY")
  find_package(OpenSSL QUIET)
  if(NOT OpenSSL_FOUND)
    set(pipecat_websocket_NOT_FOUND_MESSAGE
      "The websocket component needs OpenSSL: point OPENSSL_ROOT_DIR to it"
    )
    return()
  endif()
endif()

find_package(LibDataChannel @PIPECAT_WEBSOCKET_MIN_LIBDATACHANNEL_VERSION@ CONFIG QUIET)
if(NOT LibDataChannel_FOUND)
  set(pipecat_websocket_NOT_FOUND_MESSAGE
    "The websocket component needs libdatachannel @PIPECAT_WEBSOCKET_MIN_LIBDATACHANNEL_VERSION@ or newer"
  )
  return()
endif()

# An installed speexdsp, found with FindSpeexDSP.cmake, installed next to this
# file. A downloaded one is built into the transport.
if(NOT @PIPECAT_WEBSOCKET_SPEEXDSP_BUILT_IN@)
  set(_pipecat_module_path "${CMAKE_MODULE_PATH}")
  list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
  find_package(SpeexDSP QUIET)
  set(CMAKE_MODULE_PATH "${_pipecat_module_path}")
  if(NOT SpeexDSP_FOUND)
    set(pipecat_websocket_NOT_FOUND_MESSAGE
      "The websocket component needs speexdsp"
    )
    return()
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/pipecat-websocket-targets.cmake")

set(pipecat_websocket_FOUND TRUE)
