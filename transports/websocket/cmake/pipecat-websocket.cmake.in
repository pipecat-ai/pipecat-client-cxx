# The WebSocket transport, pipecat::websocket, loaded by
# find_package(pipecat COMPONENTS websocket).

# A static libdatachannel's package doesn't look for OpenSSL itself.
if("@PIPECAT_WEBSOCKET_LIBDATACHANNEL_TYPE@" STREQUAL "STATIC_LIBRARY")
  find_dependency(OpenSSL)
endif()
find_dependency(LibDataChannel @PIPECAT_WEBSOCKET_MIN_LIBDATACHANNEL_VERSION@ CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/pipecat-websocket-targets.cmake")

set(pipecat_websocket_FOUND TRUE)
