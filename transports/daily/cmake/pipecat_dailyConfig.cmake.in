@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(pipecat 1.0)
find_dependency(Threads)

# Daily Core has no CMake package, so use the module installed next to this
# file. It needs DailyCore_ROOT or the DAILY_CORE_PATH environment variable.
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(DailyCore)
list(POP_FRONT CMAKE_MODULE_PATH)

include("${CMAKE_CURRENT_LIST_DIR}/pipecat_dailyTargets.cmake")

check_required_components(pipecat_daily)
